{
    "name":"ALC Environment",

    "dockerComposeFile":"docker-compose.yml",
    "service":"app",
    "workspaceFolder":"/workspace",

    "customizations":{
        "vscode":{
            "extensions":[

                // ... Aquí tengo pendiente añadir el cliente de AI ...

                // Soporte de lenguaje e Inteligencia para Python.
                "ms-python.python",
                "ms-python.vscode-pylance",

                // Entorno de Notebooks y Análisis de Datos.
                "ms-toolsai.jupyter",
                "ms-toolsai.datawrangler"
            ],
            "settings":{
                "python.testing.pytestEnabled":true,
                "python.testing.pytestArgs": ["tests"],
                "python.analysis.extraPaths": ["./src"],
                "python.autoComplete.extraPaths": ["./src"]
            }
        }
    },

    "postCreateCommand": {
        "update-pip": "pip install --upgrade pip",
        "install-deps": "pip install numpy pandas matplotlib seaborn pytest"
    }

}
